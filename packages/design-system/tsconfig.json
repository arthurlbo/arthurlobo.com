{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "@repo/typescript/base.json",
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "allowJs": true,
        "noEmit": true,
        "jsx": "preserve",
        "paths": {
            "@/*": ["./src/*"]
        }
    },
    "include": ["src"],
    "exclude": ["node_modules", "dist"]
}
