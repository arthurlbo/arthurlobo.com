{
    "name": "@repo/design-system",
    "version": "1.0.0",
    "type": "module",
    "private": true,
    "scripts": {
        "build": "tsup",
        "lint": "eslint",
        "lint:fix": "eslint --fix",
        "prettier:fix": "prettier --write .",
        "format": "pnpm lint:fix && pnpm prettier:fix",
        "typecheck": "tsc --noEmit"
    },
    "files": [
        "dist"
    ],
    "exports": {
        "./components": {
            "types": "./dist/components/index.d.ts",
            "import": "./dist/components/index.mjs",
            "require": "./dist/components/index.cjs"
        },
        "./utils": {
            "types": "./dist/shared/utils/index.d.ts",
            "import": "./dist/shared/utils/index.mjs",
            "require": "./dist/shared/utils/index.cjs"
        },
        "./globals.css": "./dist/globals.css",
        "./postcss.config": "./dist/postcss.config.mjs"
    },
    "peerDependencies": {
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "dependencies": {
        "@radix-ui/react-accordion": "^1.2.12",
        "@radix-ui/react-dialog": "^1.1.15",
        "@radix-ui/react-label": "^2.1.8",
        "@radix-ui/react-separator": "^1.1.8",
        "@radix-ui/react-slot": "^1.2.4",
        "@radix-ui/react-switch": "^1.2.6",
        "@tabler/icons-react": "^3.36.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "lucide-react": "^0.562.0",
        "motion": "^12.23.26",
        "next-themes": "^0.4.6",
        "recharts": "3.6.0",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.4.0"
    },
    "devDependencies": {
        "@repo/eslint": "workspace:*",
        "@repo/tsup": "workspace:*",
        "@repo/typescript": "workspace:*",
        "@tailwindcss/postcss": "^4.1.18",
        "@types/react": "19.2.7",
        "@types/react-dom": "19.2.3",
        "eslint": "^9.39.2",
        "react": "^19.2.3",
        "react-dom": "^19.2.3",
        "tailwindcss": "^4.1.18",
        "tsup": "^8.5.1",
        "tw-animate-css": "^1.4.0",
        "typescript": "^5.9.3"
    }
}
